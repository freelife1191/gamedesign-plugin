{
  "name": "game-design-plugin-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tooling/run-repo-tests.mjs",
    "test:unit": "node tooling/run-test-group.mjs unit",
    "test:contracts": "node tooling/run-test-group.mjs contracts",
    "test:products": "node tooling/run-test-group.mjs products e2e/career e2e/studio",
    "test:formats": "node tests/formats/run-format-gate.mjs",
    "test:shared-contract": "node --test tests/contracts/shared-contract.test.mjs",
    "build": "node tooling/build-snapshots.mjs",
    "validate": "node tooling/validate-suite.mjs",
    "validate:release": "node tooling/validate-suite.mjs --release",
    "validate:guides": "node tooling/validate-user-guides.mjs --complete",
    "smoke:marketplace": "node tooling/marketplace-smoke.mjs",
    "verify:install-roundtrip": "node tooling/install-roundtrip.mjs",
    "smoke:image:live": "node tooling/smoke-openai-image.mjs",
    "build:guide-diagrams": "node tooling/build-use-case-diagrams.mjs",
    "check:guide-diagrams": "node tooling/build-use-case-diagrams.mjs --check",
    "build:prompt-guides": "node tooling/build-prompt-guides.mjs",
    "check:prompt-guides": "node tooling/build-prompt-guides.mjs --check",
    "validate:archify-catalog": "node tooling/validate-archify-catalog.mjs",
    "build:curated-archify": "node tooling/build-curated-archify.mjs --stage",
    "check:curated-archify": "node tooling/build-curated-archify.mjs --check",
    "publish:curated-archify": "node tooling/build-curated-archify.mjs --publish",
    "check:im-not-ai": "node tooling/sync-im-not-ai.mjs --check",
    "check:im-not-ai-latest": "node tooling/sync-im-not-ai.mjs --check-latest",
    "update:im-not-ai": "node tooling/sync-im-not-ai.mjs --update",
    "sync:vendor-refs": "node tooling/sync-vendor-references.mjs",
    "check:vendor-refs": "node tooling/sync-vendor-references.mjs --check",
    "check:updates": "node tooling/check-suite-updates.mjs",
    "check:updates:report": "node tooling/update-vendors.mjs --report",
    "update:vendors": "node tooling/update-vendors.mjs",
    "validate:release:latest": "node tooling/check-suite-updates.mjs --require-current && node tooling/validate-suite.mjs --release",
    "check:diagram-skills": "node tooling/sync-diagram-skills.mjs --check",
    "check:diagram-skills-latest": "node tooling/sync-diagram-skills.mjs --check-latest",
    "update:diagram-skillstead": "node tooling/sync-diagram-skills.mjs --update skillstead",
    "update:diagram-archify": "node tooling/sync-diagram-skills.mjs --update archify"
  },
  "engines": { "node": ">=18" }
}
