{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/reference-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "brief", "referenceSet", "referenceContexts", "evidence", "claims", "atlasSelection", "systemInventory", "systemMaps", "priority", "deepDives", "comparison", "transferDecisions", "verificationQueue"],
  "allOf": [
    { "properties": { "referenceSet": { "contains": { "allOf": [{ "$ref": "#/$defs/reference" }, { "properties": { "role": { "const": "direct-competitor" } } }] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "referenceSet": { "contains": { "allOf": [{ "$ref": "#/$defs/reference" }, { "properties": { "role": { "const": "core-system-exemplar" } } }] }, "minContains": 1, "maxContains": 1 } } },
    { "properties": { "referenceSet": { "contains": { "allOf": [{ "$ref": "#/$defs/reference" }, { "properties": { "role": { "const": "operations-monetization-comparator" } } }] }, "minContains": 1, "maxContains": 1 } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "receipt": { "type": "object", "additionalProperties": false, "required": ["documentId", "glossaryVersion", "glossarySha256", "termIds"], "properties": { "documentId": { "$ref": "#/$defs/id" }, "glossaryVersion": { "type": "integer", "minimum": 1 }, "glossarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "termIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TERM-[A-Z0-9]+(?:-[A-Z0-9]+)*$" } } } },
    "reference": { "type": "object", "additionalProperties": false, "required": ["referenceId", "label", "role", "decisionQuestionIds", "availability", "limitation"], "allOf": [{ "if": { "properties": { "availability": { "const": "available" } } }, "then": { "properties": { "limitation": { "type": "null" } } } }, { "if": { "properties": { "availability": { "const": "unavailable" } } }, "then": { "properties": { "limitation": { "$ref": "#/$defs/text" } } } }], "properties": { "referenceId": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "role": { "enum": ["direct-competitor", "core-system-exemplar", "operations-monetization-comparator"] }, "decisionQuestionIds": { "$ref": "#/$defs/idList" }, "availability": { "enum": ["available", "unavailable"] }, "limitation": { "type": ["string", "null"] } } },
    "context": { "type": "object", "additionalProperties": false, "required": ["contextId", "referenceId", "version", "platform"], "properties": { "contextId": { "$ref": "#/$defs/id" }, "referenceId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/text" }, "platform": { "$ref": "#/$defs/id" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "referenceId", "contextId", "systemIds", "tier", "sourceType", "availability", "limitation", "verificationQuestion", "claimKind", "claim", "build", "region", "accountState", "observedAt", "locator", "screen", "action", "result", "transformations", "rights", "conflictState", "counterexampleOf"], "allOf": [
      { "if": { "properties": { "availability": { "const": "available" } } }, "then": { "properties": { "limitation": { "type": "null" }, "verificationQuestion": { "type": "null" } } } },
      { "if": { "properties": { "availability": { "const": "unavailable" } } }, "then": { "properties": { "limitation": { "$ref": "#/$defs/text" }, "verificationQuestion": { "$ref": "#/$defs/text" } } } },
      { "if": { "properties": { "sourceType": { "enum": ["direct-play", "official-site", "official-patch-note", "official-odds", "official-store"] } } }, "then": { "properties": { "tier": { "const": "primary" } } } },
      { "if": { "properties": { "sourceType": { "enum": ["developer-talk", "curated-wiki", "expert-guide"] } } }, "then": { "properties": { "tier": { "const": "supporting" } } } },
      { "if": { "properties": { "sourceType": { "enum": ["community", "video", "review", "unofficial-tracker"] } } }, "then": { "properties": { "tier": { "const": "discovery" } } } },
      { "if": { "properties": { "locator": { "properties": { "kind": { "const": "project-relative" } } } } }, "then": { "properties": { "locator": { "properties": { "value": { "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$" } } } } } }
    ], "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "referenceId": { "$ref": "#/$defs/id" }, "contextId": { "$ref": "#/$defs/id" }, "systemIds": { "$ref": "#/$defs/idList" }, "tier": { "enum": ["primary", "supporting", "discovery"] }, "sourceType": { "enum": ["direct-play", "official-site", "official-patch-note", "official-odds", "official-store", "developer-talk", "curated-wiki", "expert-guide", "community", "video", "review", "unofficial-tracker"] }, "availability": { "enum": ["available", "unavailable"] }, "limitation": { "type": ["string", "null"] }, "verificationQuestion": { "type": ["string", "null"] }, "claimKind": { "enum": ["observation", "inference", "hypothesis", "unknown"] }, "claim": { "$ref": "#/$defs/text" }, "build": { "$ref": "#/$defs/text" }, "region": { "$ref": "#/$defs/text" }, "accountState": { "$ref": "#/$defs/text" }, "observedAt": { "$ref": "#/$defs/text" }, "locator": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "enum": ["url", "project-relative"] }, "value": { "$ref": "#/$defs/text" } } }, "screen": { "$ref": "#/$defs/text" }, "action": { "$ref": "#/$defs/text" }, "result": { "$ref": "#/$defs/text" }, "transformations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "enum": ["original", "capture", "summary"] }, "to": { "enum": ["original", "capture", "summary"] } } } }, "rights": { "type": "object", "additionalProperties": false, "required": ["copyright", "use", "publication"], "properties": { "copyright": { "$ref": "#/$defs/text" }, "use": { "enum": ["analysis", "internal-review"] }, "publication": { "enum": ["private", "redacted"] } } }, "conflictState": { "enum": ["none", "conflicting"] }, "counterexampleOf": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["claimId", "systemIds", "evidenceIds", "kind", "category", "causal"], "properties": { "claimId": { "$ref": "#/$defs/id" }, "systemIds": { "$ref": "#/$defs/idList" }, "evidenceIds": { "$ref": "#/$defs/idList" }, "kind": { "enum": ["observation", "inference", "hypothesis", "unknown"] }, "category": { "enum": ["general", "monetization", "retention", "performance"] }, "causal": { "type": "boolean" } } },
    "coverage": { "required": ["evidenceIds", "referenceIds", "contextIds", "coverageCount"], "properties": { "evidenceIds": { "$ref": "#/$defs/idArray" }, "referenceIds": { "$ref": "#/$defs/idArray" }, "contextIds": { "$ref": "#/$defs/idArray" }, "coverageCount": { "type": "integer", "minimum": 0 } } },
    "node": { "type": "object", "additionalProperties": false, "required": ["nodeId", "kind", "label"], "properties": { "nodeId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["input", "process", "output"] }, "label": { "$ref": "#/$defs/text" } } },
    "connection": { "type": "object", "additionalProperties": false, "required": ["connectionId", "fromNodeId", "toNodeId", "connectedSystemIds"], "properties": { "connectionId": { "$ref": "#/$defs/id" }, "fromNodeId": { "$ref": "#/$defs/id" }, "toNodeId": { "$ref": "#/$defs/id" }, "connectedSystemIds": { "$ref": "#/$defs/idList" } } },
    "loop": { "type": "object", "additionalProperties": false, "required": ["loopId", "kind", "nodeIds"], "properties": { "loopId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["core", "session", "meta"] }, "nodeIds": { "$ref": "#/$defs/idList" } } }
  },
  "properties": {
    "schemaVersion": { "const": 1 }, "analysisId": { "$ref": "#/$defs/id" },
    "brief": { "type": "object", "additionalProperties": false, "required": ["objective", "decisionQuestions", "playerExperiencePromise", "differentiationHypotheses", "genreHypotheses", "platformHypotheses", "businessModelHypotheses", "researchScope", "exclusionScope", "constraints", "forbiddenConclusions", "completionCriteria", "humanReviewer"], "properties": { "objective": { "$ref": "#/$defs/text" }, "decisionQuestions": { "$ref": "#/$defs/idList" }, "playerExperiencePromise": { "$ref": "#/$defs/text" }, "differentiationHypotheses": { "$ref": "#/$defs/idList" }, "genreHypotheses": { "$ref": "#/$defs/idList" }, "platformHypotheses": { "$ref": "#/$defs/idList" }, "businessModelHypotheses": { "$ref": "#/$defs/idList" }, "researchScope": { "$ref": "#/$defs/idList" }, "exclusionScope": { "$ref": "#/$defs/idList" }, "constraints": { "type": "object", "additionalProperties": false, "required": ["time", "materials", "languages", "regions"], "properties": { "time": { "$ref": "#/$defs/text" }, "materials": { "$ref": "#/$defs/idList" }, "languages": { "$ref": "#/$defs/idList" }, "regions": { "$ref": "#/$defs/idList" } } }, "forbiddenConclusions": { "$ref": "#/$defs/idList" }, "completionCriteria": { "$ref": "#/$defs/idList" }, "humanReviewer": { "$ref": "#/$defs/text" } } },
    "referenceSet": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "referenceContexts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/context" } },
    "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
    "claims": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/claim" } },
    "atlasSelection": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["questionId", "systemId", "applicability", "rationale", "conditions", "verificationPrompts"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "systemId": { "$ref": "#/$defs/id" }, "applicability": { "enum": ["required-candidate", "conditional", "optional", "not-applicable", "unknown"] }, "rationale": { "$ref": "#/$defs/text" }, "conditions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "verificationPrompts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } } } } },
    "systemInventory": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["systemId", "name", "applicability", "evidenceIds"], "properties": { "systemId": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "applicability": { "enum": ["required-candidate", "conditional", "optional", "not-applicable", "unknown"] }, "evidenceIds": { "$ref": "#/$defs/idArray" } } } },
    "systemMaps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["mapId", "systemId", "nodes", "connections", "loops"], "properties": { "mapId": { "$ref": "#/$defs/id" }, "systemId": { "$ref": "#/$defs/id" }, "nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/node" } }, "connections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/connection" } }, "loops": { "type": "array", "items": { "$ref": "#/$defs/loop" } } } } },
    "priority": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["systemId", "rank", "rationale", "relevance", "playerExperienceImpact", "economyProgressionImpact", "differentiationPotential", "evidenceStrength", "uncertainty", "researchCost"], "properties": { "systemId": { "$ref": "#/$defs/id" }, "rank": { "type": "integer", "minimum": 1 }, "rationale": { "$ref": "#/$defs/text" }, "relevance": { "type": "integer", "minimum": 1, "maximum": 5 }, "playerExperienceImpact": { "type": "integer", "minimum": 1, "maximum": 5 }, "economyProgressionImpact": { "type": "integer", "minimum": 1, "maximum": 5 }, "differentiationPotential": { "type": "integer", "minimum": 1, "maximum": 5 }, "evidenceStrength": { "type": "integer", "minimum": 1, "maximum": 5 }, "uncertainty": { "type": "integer", "minimum": 1, "maximum": 5 }, "researchCost": { "type": "integer", "minimum": 1, "maximum": 5 } } } },
    "deepDives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/coverage" }, { "type": "object", "additionalProperties": false, "required": ["systemId", "claimKind", "finding", "evidenceIds", "referenceIds", "contextIds", "coverageCount"], "properties": { "systemId": { "$ref": "#/$defs/id" }, "claimKind": { "enum": ["observation", "inference", "hypothesis", "unknown"] }, "finding": { "$ref": "#/$defs/text" }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "referenceIds": { "$ref": "#/$defs/idArray" }, "contextIds": { "$ref": "#/$defs/idArray" }, "coverageCount": { "type": "integer", "minimum": 0 } } }] } },
    "comparison": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/coverage" }, { "type": "object", "additionalProperties": false, "required": ["comparisonId", "sourceSystemId", "state", "subject", "claimKind", "finding", "evidenceIds", "referenceIds", "contextIds", "coverageCount"], "properties": { "comparisonId": { "$ref": "#/$defs/id" }, "sourceSystemId": { "$ref": "#/$defs/id" }, "state": { "enum": ["hold", "ready"] }, "subject": { "$ref": "#/$defs/text" }, "claimKind": { "enum": ["observation", "inference", "hypothesis", "unknown"] }, "finding": { "$ref": "#/$defs/text" }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "referenceIds": { "$ref": "#/$defs/idArray" }, "contextIds": { "$ref": "#/$defs/idArray" }, "coverageCount": { "type": "integer", "minimum": 0 } } }] } },
    "transferDecisions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "allOf": [{ "$ref": "#/$defs/coverage" }, { "type": "object", "additionalProperties": false, "required": ["transferId", "sourceSystemId", "decision", "rationale", "evidenceIds", "referenceIds", "contextIds", "coverageCount", "projectConstraints", "risks", "validationSteps", "validationState", "glossaryReceipt", "reviewState"], "properties": { "transferId": { "$ref": "#/$defs/id" }, "sourceSystemId": { "$ref": "#/$defs/id" }, "decision": { "enum": ["adopt", "adapt", "reject", "hold"] }, "rationale": { "$ref": "#/$defs/text" }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "referenceIds": { "$ref": "#/$defs/idArray" }, "contextIds": { "$ref": "#/$defs/idArray" }, "coverageCount": { "type": "integer", "minimum": 0 }, "projectConstraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "validationSteps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "validationState": { "const": "not-run" }, "glossaryReceipt": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/receipt" }] }, "reviewState": { "const": "pending-review" } } }] } },
    "verificationQueue": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["verificationId", "question", "evidenceIds", "state"], "properties": { "verificationId": { "$ref": "#/$defs/id" }, "question": { "$ref": "#/$defs/text" }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "state": { "const": "open" } } } }
  }
}
