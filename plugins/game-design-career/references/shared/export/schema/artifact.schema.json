{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/artifact.schema.json",
  "title": "Canonical Game Design Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "artifact_id", "version"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "quality_profile": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 }
  },
  "x-canonical-package": {
    "requiredFiles": ["content.md", "evidence.yml", "export-manifest.yml"],
    "requiredDirectories": ["decisions", "assets"]
  }
}
