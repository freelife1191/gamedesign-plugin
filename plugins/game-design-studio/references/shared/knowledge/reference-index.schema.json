{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.game-design-plugin/shared/knowledge/reference-index.schema.json",
  "title": "Game design source reference index",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourcePath", "title", "category", "sha256", "wordCount", "claimTypes", "derivedCore"],
        "properties": {
          "id": { "type": "string", "pattern": "^(career|fun-intent|systems|content|feedback)-[a-f0-9]{12}$" },
          "sourcePath": { "type": "string", "pattern": "^docs/.+\\.md$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "enum": ["career", "fun-intent", "systems", "content", "feedback"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "wordCount": { "type": "integer", "minimum": 1 },
          "claimTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["evergreen", "contextual", "time-sensitive"] }
          },
          "derivedCore": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
