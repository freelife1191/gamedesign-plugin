  "meta": {
    "title": "Studio to Career Public Evidence Handoff",
    "subtitle": "A separate public/evidence-safe summary crosses two product boundaries only after named human approval.",
    "output": "guides/assets/archify/suite/suite-studio-career-handoff.html",
    "viewBox": [1200, 660],
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "bounded-handoff",
        "label": "Bounded handoff",
        "focus": ["studio_boundary", "public_evidence_summary", "career_boundary", "career_portfolio_input"],
        "note": "Studio and Career artifacts remain separate; only a public, evidence-safe summary crosses the handoff."
      },
      {
        "id": "human-approval",
        "label": "Human approval",
        "focus": ["public_evidence_summary", "decision_owner", "held_handoff"],
        "note": "The named decision owner approves public scope or holds the handoff when rights, evidence, or the receipt is missing."
      },
      {
        "id": "resume-held-review",
        "label": "Resume held review",
        "focus": ["studio_boundary", "public_evidence_summary", "decision_owner", "career_boundary", "held_handoff", "resume_receipt", "career_portfolio_input"],
        "note": "Preserve the blocker and resume the same public-only review after a new receipt is available."
      }
    ]
  },
  "stages": [
    { "label": "Studio boundary" },
    { "label": "Public handoff artifact" },
    { "label": "Human approval boundary" },
    { "label": "Career boundary" },
    { "label": "Career input" }
