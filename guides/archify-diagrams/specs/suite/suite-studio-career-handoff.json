    {
      "dot": "cyan",
      "title": "Handoff artifact",
      "items": [
        "Send only a public problem, decision, alternatives, and verified evidence summary",
        "Do not copy the Studio canonical artifact into the Career portfolio artifact",
        "Keep fact, inference, and recommendation distinct in the Career input"
      ]
    },
    {
      "dot": "amber",
      "title": "Human approval boundary",
      "items": [
        "A named human decision owner approves or holds the public scope",
        "Do not request credentials, personal data, or private materials",
        "Approval is not automatic and does not guarantee a hiring outcome"
      ]
    },
    {
      "dot": "violet",
      "title": "Hold and resume",
      "items": [
        "Hold when rights, evidence, or the approval receipt is missing",
