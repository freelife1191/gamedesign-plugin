  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence boundary",
      "items": [
        "Each claim retains its source, reference date, scope, and limit",
        "A 1–12 week student project turns the recorded gap into reviewable work",
        "Do not turn a missing job listing into a general role requirement",
        "Record only work and contributions that actually happened"
      ]
    },
    {
      "dot": "amber",
      "title": "Career routes",
      "items": [
        "Portfolio makes problem, judgment, contribution, result, and evidence a case study; interview connects job requirements to evidence IDs",
        "Growth connects project impact, feedback, and the next experiment",
        "Preparing files does not guarantee a hiring outcome"
      ]
    },
    {
      "dot": "amber",
      "title": "Review layers",
      "items": [
        "Content: judge the case-study explanation separately",
        "Evidence: keep each claim verifiable or mark its gap",
        "Document quality: keep format and clarity separate from content and evidence",
        "Conflicting recommendations remain decision items; resolve privacy, rights, confidentiality, and inflated claims before approval"
      ]
    },
    {
      "dot": "violet",
      "title": "Resume contract",
      "items": [
        "Keep artifact path, diagnosis stage, evidence date, completed work, and blocked claim",
        "Resume the held job-listing freshness check, not a generic earlier stage",
        "The next learning target comes from the recorded evidence gap"
      ]
    }
  ]
