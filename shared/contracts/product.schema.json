{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.game-design-plugin/shared/contracts/product.schema.json",
  "title": "Game design plugin product overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "description",
    "sharedModules",
    "sharedRuntime",
    "sourceRoots"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sharedModules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["knowledge", "templates", "responsible-design", "export", "vendor", "archify", "im-not-ai", "document-quality", "image-assets", "memory"]
      }
    },
    "sharedRuntime": { "const": true },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceDocuments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceDocumentCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "oneOf": [
    {
      "required": ["sourceDocuments"],
      "not": { "required": ["sourceDocumentCategories"] }
    },
    {
      "required": ["sourceDocumentCategories"],
      "not": { "required": ["sourceDocuments"] }
    }
  ]
}
