{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://local.game-design-plugin/shared/image-assets/schema/cutscene-generation-approval.schema.json", "title": "Cutscene live generation approval receipt", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "actor", "reviewer", "decision", "decidedAt", "waveId", "assetIds", "maximumApprovedUsd", "retryReserve", "planSha256", "promptPackageSha256", "referenceBindings", "pricingSnapshotSha256", "costEstimateSha256"],
  "properties": {"schemaVersion": {"const": 1}, "eventId": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "reviewer": {"type": "string", "minLength": 1}, "decision": {"const": "approved"}, "decidedAt": {"type": "string", "format": "date-time"}, "waveId": {"enum": ["style-master", "reference-masters", "keyframes", "storyboard"]}, "assetIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "maximumApprovedUsd": {"type": "number", "minimum": 0}, "retryReserve": {"type": "integer", "minimum": 0}, "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "promptPackageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "referenceBindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["assetId", "sha256"], "properties": {"assetId": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}, "pricingSnapshotSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "costEstimateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
