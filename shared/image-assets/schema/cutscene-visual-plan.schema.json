{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.game-design-plugin/shared/image-assets/schema/cutscene-visual-plan.schema.json",
  "title": "Cutscene visual preproduction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cutsceneId", "mode", "beats", "shots", "cutsceneWorkflow"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cutsceneId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "mode": {"enum": ["prompt-only", "estimate-only", "generate-after-approval"]},
    "beats": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["beatId"], "properties": {"beatId": {"type": "string", "minLength": 1}}}},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["shotId", "beatId"], "properties": {"shotId": {"type": "string", "minLength": 1}, "beatId": {"type": "string", "minLength": 1}}}},
    "cutsceneWorkflow": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "waves", "downstream", "derived"], "properties": {"schemaVersion": {"const": 1}, "waves": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "state", "assetIds", "estimate", "approval", "attempts", "completion", "invalidation"], "properties": {"id": {"enum": ["style-master", "reference-masters", "keyframes", "storyboard"]}, "state": {"enum": ["planned", "template-ready", "generation-ready", "cost-estimated", "approval-pending", "approved", "dispatching", "completed", "blocked", "invalidated"]}, "assetIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}, "estimate": {"type": ["object", "null"]}, "approval": {"type": ["object", "null"]}, "attempts": {"type": "array"}, "completion": {"type": ["object", "null"]}, "invalidation": {"type": ["object", "null"]}}}}, "downstream": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fromWaveId", "toWaveId"], "properties": {"fromWaveId": {"enum": ["style-master", "reference-masters", "keyframes", "storyboard"]}, "toWaveId": {"enum": ["style-master", "reference-masters", "keyframes", "storyboard"]}}}}, "derived": {"type": "object"}}}
  }
}
