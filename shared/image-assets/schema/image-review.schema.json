{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.game-design-plugin/shared/image-assets/schema/image-review.schema.json",
  "title": "Named image approval review",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "reviewer", "reviewed_at", "evidence_paths", "rights_decision"],
  "properties": {
    "state": { "enum": ["document-approved", "production-candidate"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
    },
    "rights_decision": { "enum": ["approved", "restricted", "rejected", "needs-review"] }
  }
}
