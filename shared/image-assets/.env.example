# 이미지 생성 방식입니다. 허용 값: required | all | select | prompt-only
#
# prompt-only(기본값): 외부 이미지 생성 기능을 호출하지 않습니다. 이미지
# 자산 계획, 재사용할 프롬프트와 자리표시자만 만들므로 생성 비용이 들지 않고
# 대기 시간도 가장 짧습니다.
# required: 선택한 문서 품질 기준에서 필수로 지정한 이미지만 만듭니다. 비용과
# 시간은 정해진 필수 이미지 수에 따라 늘어납니다.
# all: 목록에 이미 등록된 필수·권장·변형 이미지를 모두 만듭니다. 비용과 시간이
# 가장 많이 들지만 목록에 없는 변형 이미지를 임의로 추가하지는 않습니다.
# select: 이미지 목록, 프롬프트와 예상 개수부터 비용 없이 준비합니다. 사용자가
# 고정 자산 ID를 직접 고른 뒤에만 생성을 시작하며, 비용과 시간은 선택한 수량에
# 따라 달라집니다.
IMAGE_GEN_MODE=prompt-only

# 이미지 생성 경로입니다. 허용 값: codex-first | openai, 기본값: codex-first
# codex-first는 API 키가 있어도 현재 환경의 image_gen 기능을 먼저 사용합니다.
# OpenAI로 몰래 전환해 API 비용을 쓰지 않습니다.
# openai는 사용자가 직접 고르는 유료 경로입니다. 실행할 작업 수와 예상 비용을
# 먼저 안내하고, 사용자가 해당 작업을 승인한 뒤에만 호출합니다.
IMAGE_PROVIDER=codex-first

# 이미지에 넣을 글자의 언어입니다. 허용 값: none | ko-KR, 기본값: none
# 이미지 안에 한글이 꼭 들어가야 할 때만 ko-KR을 사용합니다. 이 설정에는
# IMAGE_PROVIDER=openai와 IMAGE_MODEL=gpt-image-2가 필요합니다.
IMAGE_EMBEDDED_TEXT_LOCALE=none

# OpenAI Images API 모델입니다. 기본값: gpt-image-2
IMAGE_MODEL=gpt-image-2

# 이미지 품질입니다. 허용 값: low | medium | high | auto, 기본값: low
# 초안, 스토리보드 프레임과 변형 이미지는 대부분 low로 만듭니다. 골라낸 기준
# 이미지나 최종 품질이 필요할 때만 medium을 사용합니다. high는 비용이 크게
# 늘 수 있으므로 영상의 대표 프레임이나 제작용 콘셉트 아트처럼 근거가 분명한
# 예외 작업에만 사용합니다.
IMAGE_QUALITY=low

# 요청별 OpenAI 제한 시간입니다. 단위는 밀리초이며 기본값은 30000입니다.
# 이 시간을 넘긴 요청은 중단하고 실패 기록을 남깁니다. 다른 이미지 생성 경로로
# 자동 전환하지 않습니다. 이미지 생성에는 비용이 들 수 있으므로 제한 시간을
# 반드시 정해 두세요.
IMAGE_REQUEST_TIMEOUT_MS=30000

# API 키가 있다고 해서 비용 사용에 동의한 것은 아닙니다. 유료 OpenAI Images
# API는 IMAGE_PROVIDER=openai를 직접 선택한 경우에만 사용합니다. 인증·할당량·
# 요청·정책·네트워크 오류가 발생해도 Codex로 자동 전환하지 않습니다. 대신
# 프롬프트를 보존하고 사용할 경로를 다시 선택하도록 안내합니다. 선택한 이미지
# 생성 기능을 쓸 수 없을 때도 프롬프트와 자리표시자는 그대로 남깁니다.
# 생성한 이미지는 콘셉트 초안입니다. 이미지 생성만으로 문서나 제작물이 승인되지는
# 않으며, 담당자가 결과를 검토해 승인해야 합니다.
# 이 예시 파일에는 실제 API 키를 넣지 말고, 실제 키를 버전 관리에 올리지 마세요.
OPENAI_API_KEY=

# 게임 기획 장기 기억 기능을 사용할지 정합니다.
# false이면 기억 폴더를 만들거나 읽지 않고, 후보·색인·사용 기록도 만들지
# 않습니다. 기존 Studio와 Career 기능은 그대로 동작합니다.
# 기본값: true
GAME_DESIGN_MEMORY_ENABLED=true

# 기억 공유 범위입니다. project | workspace | global 중 하나를 사용합니다.
# project가 가장 안전한 기본값이며, 범위를 넓혀도 기존 기록은 자동으로
# 승격되지 않습니다.
# 기본값: project
GAME_DESIGN_MEMORY_SCOPE=project

# 한 작업에 적용할 승인된 기억의 최대 개수입니다.
# 허용 범위: 1~10, 기본값: 5
GAME_DESIGN_MEMORY_MAX_ITEMS=5

# 승인되지 않은 기억 후보의 유효 기간입니다.
# 허용 범위: 1~365일, 기본값: 30일
GAME_DESIGN_MEMORY_CANDIDATE_TTL_DAYS=30

# local은 .game-design/을 로컬에만 보관합니다.
# tracked는 사용자가 명시적으로 선택한 경우에만 Git 추적을 허용하지만
# 플러그인이 자동 커밋하지는 않습니다.
# 기본값: local
GAME_DESIGN_MEMORY_GIT_MODE=local
