{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/export-manifest.schema.json",
  "title": "Artifact Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "formats"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["md", "pdf", "docx", "pptx"],
      "properties": {
        "md": { "$ref": "#/$defs/formatStatus" },
        "pdf": { "$ref": "#/$defs/formatStatus" },
        "docx": { "$ref": "#/$defs/formatStatus" },
        "pptx": {
          "allOf": [
            { "$ref": "#/$defs/formatStatus" },
            {
              "type": "object",
              "properties": {
                "audience": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string", "minLength": 1 },
                "slide_outline": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title"],
                    "properties": { "title": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "formatStatus": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "enum": ["pending", "passed", "failed", "unavailable"] } }
    }
  }
}
