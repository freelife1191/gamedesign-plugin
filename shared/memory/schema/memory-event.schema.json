{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/memory-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "action", "memory_id", "operation_id", "parent_event_ids", "effective_at", "actor", "reason", "record"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_type": { "enum": ["capture", "transition", "resolution"] },
    "action": { "type": "string", "pattern": ".*\\S.*" },
    "memory_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operation_id": { "type": "string", "pattern": "^(?:mev1|mop1)-[a-f0-9]{64}$" },
    "parent_event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^mev1-[a-f0-9]{64}$" } },
    "chosen_parent_event_id": { "type": "string", "pattern": "^mev1-[a-f0-9]{64}$" },
    "effective_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "reason": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "record": { "$ref": "memory-record.schema.json" }
  }
}
