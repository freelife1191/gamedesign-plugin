{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/memory-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "action", "memory_id", "operation_id", "parent_event_ids", "effective_at", "actor", "reason", "record"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_type": { "enum": ["capture", "transition", "resolution"] },
    "action": { "type": "string", "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$" },
    "memory_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operation_id": { "type": "string", "pattern": "^(?:(?!(?:mev1|mop1)-)[a-z0-9]+(?:-[a-z0-9]+)*|mop1-[a-f0-9]{64})$" },
    "parent_event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^mev1-[a-f0-9]{64}$" } },
    "chosen_parent_event_id": { "type": "string", "pattern": "^mev1-[a-f0-9]{64}$" },
    "effective_at": { "type": "string", "format": "date-time", "pattern": "^[^\\u0000]*$" },
    "actor": { "type": "string", "minLength": 1, "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$" },
    "reason": { "type": "string", "minLength": 1, "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*$" },
    "record": { "$ref": "memory-record.schema.json" }
  },
  "allOf": [
    { "if": { "properties": { "event_type": { "const": "capture" } } }, "then": { "properties": { "action": { "const": "capture" }, "parent_event_ids": { "maxItems": 0 }, "operation_id": { "pattern": "^(?!(?:mev1|mop1)-)[a-z0-9]+(?:-[a-z0-9]+)*$" } }, "not": { "required": ["chosen_parent_event_id"] } } },
    { "if": { "properties": { "event_type": { "const": "transition" } } }, "then": { "properties": { "action": { "enum": ["candidate", "verified", "approved", "expired", "rejected", "disputed", "superseded", "stale"] }, "parent_event_ids": { "minItems": 1, "maxItems": 1 }, "operation_id": { "pattern": "^mop1-[a-f0-9]{64}$" } }, "not": { "required": ["chosen_parent_event_id"] } } },
    { "if": { "properties": { "event_type": { "const": "resolution" } } }, "then": { "required": ["chosen_parent_event_id"], "properties": { "action": { "const": "resolution" }, "parent_event_ids": { "minItems": 2 }, "operation_id": { "pattern": "^mop1-[a-f0-9]{64}$" } } } }
  ]
}
