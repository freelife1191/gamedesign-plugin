{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/shared/scripts/capability-probe.mjs\"",
            "timeout": 10,
            "statusMessage": "Detecting optional game-design capabilities"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/shared/scripts/stop-artifact-review.mjs\"",
            "timeout": 30,
            "statusMessage": "Reviewing canonical game-design artifact"
          }
        ]
      }
    ]
  }
}
