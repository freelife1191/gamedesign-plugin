{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.game-design-plugin/shared/document-quality/schema/quality-profile.schema.json",
  "title": "Document quality profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "artifact_types",
    "audiences",
    "required_sections",
    "required_tables",
    "required_diagrams",
    "required_images",
    "recommended_images",
    "length_guidance",
    "ppt_story_contract",
    "acceptance_criteria",
    "export_rules",
    "quality_checks"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["export_rules"],
        "properties": {
          "export_rules": {
            "type": "object",
            "required": ["required_formats"],
            "properties": { "required_formats": { "type": "array", "contains": { "const": "pptx" } } }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "artifact_types": { "type": "array", "contains": { "const": "presentation" } },
          "ppt_story_contract": {
            "type": "object",
            "required": [
              "min_slides", "max_slides", "audience_required", "decision_purpose_required",
              "one_message_per_slide", "required_slide_fields", "allowed_section_ids",
              "visual_bindings", "speaker_note_policy"
            ],
            "properties": {
              "audience_required": { "const": true },
              "decision_purpose_required": { "const": true },
              "one_message_per_slide": { "const": true },
              "speaker_note_policy": { "const": "required-for-every-slide" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "sectionAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section_id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "section_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "alt_text": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "visualBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_slot_id", "section_id"],
      "properties": {
        "visual_slot_id": { "$ref": "#/$defs/stableId" },
        "section_id": { "$ref": "#/$defs/stableId" }
      }
    }
  },
  "properties": {
    "profile_id": { "$ref": "#/$defs/stableId" },
    "version": { "type": "integer", "minimum": 1 },
    "artifact_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "required_sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/section" } },
    "required_tables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sectionAsset" } },
    "required_diagrams": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sectionAsset" } },
    "required_images": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sectionAsset" } },
    "recommended_images": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sectionAsset" } },
    "length_guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_words": { "type": "integer", "minimum": 0 },
        "max_words": { "type": "integer", "minimum": 0 },
        "min_pages": { "type": "integer", "minimum": 0 },
        "max_pages": { "type": "integer", "minimum": 0 }
      }
    },
    "ppt_story_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_slides": { "type": "integer", "minimum": 1 },
        "max_slides": { "type": "integer", "minimum": 1 },
        "required_diagram_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "required_image_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "audience_required": { "type": "boolean" },
        "decision_purpose_required": { "type": "boolean" },
        "one_message_per_slide": { "type": "boolean" },
        "required_slide_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["id", "title", "message", "purpose", "source_section_ids", "visual_slots", "speaker_notes_required"] }
        },
        "allowed_section_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "visual_bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/visualBinding" } },
        "speaker_note_policy": { "type": "string", "enum": ["required-for-every-slide"] },
        "story_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "order": { "type": "integer", "minimum": 1 },
              "section_id": { "$ref": "#/$defs/stableId" },
              "diagram_id": { "$ref": "#/$defs/stableId" },
              "image_id": { "$ref": "#/$defs/stableId" }
            }
          }
        }
      }
    },
    "acceptance_criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "export_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_formats": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "forbidden_formats": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
      }
    },
    "quality_checks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
  }
}
