{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design-plugin.local/schema/game-design-glossary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "version", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "enum": ["shared", "project-overlay"] },
    "version": { "type": "integer", "minimum": 1 },
    "terms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["termId", "conceptId", "preferredTerm", "translations", "state"], "properties": { "termId": { "type": "string", "pattern": "^TERM-[A-Z0-9]+(?:-[A-Z0-9]+)*$" }, "conceptId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "preferredTerm": { "type": "string", "minLength": 1 }, "translations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["locale", "term"], "properties": { "locale": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "term": { "type": "string", "minLength": 1 } } } }, "state": { "enum": ["proposed", "approved", "deprecated"] } } } }
  }
}
