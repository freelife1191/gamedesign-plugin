# Image generation mode. Allowed: required | all | select | prompt-only
#
# prompt-only (default): makes zero external generation calls. It creates the
# asset plan, reusable prompts, and placeholders, so it has no generation cost
# and the shortest generation wait.
# required: generates only assets marked required by the selected document
# quality profile. Cost and time grow with the finite required asset count.
# all: generates every required, recommended, and variant asset already declared
# in the manifest. It has the highest bounded cost and time; it never invents
# unlisted variants.
# select: first creates the asset list, prompts, and expected count with zero
# external calls. Generation starts only after explicit stable asset IDs are
# selected, and cost and time depend on that selection.
IMAGE_GEN_MODE=prompt-only

# Provider choice. Allowed: codex-first | openai. Default: codex-first.
# codex-first uses the available host image_gen capability even when an API key
# exists. It never spends API credit by silently falling back to OpenAI.
# openai is an explicit paid route and still requires cost disclosure and the
# user's current approval for the selected finite jobs.
IMAGE_PROVIDER=codex-first

# On-image text locale. Allowed: none | ko-KR. Default: none.
# Use ko-KR only when Korean characters must be rendered inside the image.
# That route requires IMAGE_PROVIDER=openai and IMAGE_MODEL=gpt-image-2.
IMAGE_EMBEDDED_TEXT_LOCALE=none

# OpenAI Images API model. Default: gpt-image-2
IMAGE_MODEL=gpt-image-2

# Image quality. Allowed: low | medium | high | auto. Default: low.
# Keep most drafts, storyboard frames, and variants on low. Use medium only for
# selected masters or final-quality needs. High is exceptional for a justified
# video hero frame or production concept-art need because it can cost much more.
IMAGE_QUALITY=low

# Per-request OpenAI timeout in milliseconds. Default: 30000. A request that
# exceeds this limit is aborted, records a failed attempt, and never switches
# to another provider. Keep this finite because image generation has a cost.
IMAGE_REQUEST_TIMEOUT_MS=30000

# Key presence is credential availability, not consent to spend. Only
# IMAGE_PROVIDER=openai can select the paid OpenAI Images API. OpenAI API,
# authentication, quota, request, policy, or network failures never fall back
# to Codex automatically; the workflow preserves prompts and asks for a new
# explicit route decision. If no selected provider is available, prompts and
# placeholders are preserved.
# Generated images remain concept drafts: generation never grants document or
# production approval, which requires a named human review.
# Never put a real key in this example or commit a real key to version control.
OPENAI_API_KEY=

# 게임 기획 장기 기억 기능을 사용할지 정합니다.
# false이면 기억 폴더를 만들거나 읽지 않고, 후보·색인·사용 기록도 만들지
# 않습니다. 기존 Studio와 Career 기능은 그대로 동작합니다.
# 기본값: true
GAME_DESIGN_MEMORY_ENABLED=true

# 기억 공유 범위입니다. project | workspace | global 중 하나를 사용합니다.
# project가 가장 안전한 기본값이며, 범위를 넓혀도 기존 기록은 자동으로
# 승격되지 않습니다.
# 기본값: project
GAME_DESIGN_MEMORY_SCOPE=project

# 한 작업에 적용할 승인된 기억의 최대 개수입니다.
# 허용 범위: 1~10, 기본값: 5
GAME_DESIGN_MEMORY_MAX_ITEMS=5

# 승인되지 않은 기억 후보의 유효 기간입니다.
# 허용 범위: 1~365일, 기본값: 30일
GAME_DESIGN_MEMORY_CANDIDATE_TTL_DAYS=30

# local은 .game-design/을 로컬에만 보관합니다.
# tracked는 사용자가 명시적으로 선택한 경우에만 Git 추적을 허용하지만
# 플러그인이 자동 커밋하지는 않습니다.
# 기본값: local
GAME_DESIGN_MEMORY_GIT_MODE=local
