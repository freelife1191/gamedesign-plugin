{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-evidence-schema.json",
  "title": "Game Design Job Evidence Record",
  "type": "object",
  "required": [
    "sourceId",
    "company",
    "project",
    "region",
    "employmentType",
    "postedDate",
    "sourceUrl",
    "retrievalDate",
    "reviewAfter",
    "responsibilities",
    "requiredSkills",
    "preferredSkills",
    "repeatedSignals",
    "applicantEvidence",
    "gaps",
    "nonGeneralizable",
    "sampleSize",
    "sampleGeography",
    "sourceType",
    "blindSpots",
    "inferenceLimits"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable posting identifier that must be unique within the evidence collection."
    },
    "company": { "type": "string", "minLength": 1 },
    "project": { "type": ["string", "null"] },
    "region": { "type": "string", "minLength": 1 },
    "employmentType": { "type": "string", "minLength": 1 },
    "postedDate": { "type": ["string", "null"], "format": "date" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "retrievalDate": { "type": "string", "format": "date" },
    "reviewAfter": { "type": "string", "format": "date" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "requiredSkills": { "type": "array", "items": { "type": "string" } },
    "preferredSkills": { "type": "array", "items": { "type": "string" } },
    "repeatedSignals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signalId", "signal", "normalizedValue", "count", "denominator", "sourceRefs"],
        "properties": {
          "signalId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "signal": { "type": "string", "minLength": 1 },
          "normalizedValue": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 2 },
          "denominator": { "type": "integer", "minimum": 2 },
          "sourceRefs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["sourceId", "field", "index", "statement", "normalizedValue", "requirementId"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "enum": ["responsibilities", "requiredSkills", "preferredSkills"] },
                "index": { "type": "integer", "minimum": 0 },
                "statement": { "type": "string", "minLength": 1 },
                "normalizedValue": { "type": "string", "minLength": 1 },
                "requirementId": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "applicantEvidence": { "type": "array", "items": { "type": "string" } },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "nonGeneralizable": { "type": "array", "items": { "type": "string" } },
    "sampleSize": { "type": "integer", "minimum": 1 },
    "sampleGeography": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sourceType": {
      "type": "string",
      "enum": ["official-company-career-page", "official-project-or-platform", "secondary-context"]
    },
    "blindSpots": { "type": "array", "items": { "type": "string" } },
    "inferenceLimits": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
